# 便签管理和 PNG 长图导出共用同一个服务基础地址。
NOTES_API_BASE_URL=http://127.0.0.1:18080

# 普通多用户部署：填写普通用户的用户名/邮箱和密码。
# 单人部署：可从项目根目录 .env 复制对应值：
#   SUPERADMIN         -> NOTES_API_USERNAME
#   SUPERADMINPASSWORD -> NOTES_API_PASSWORD
# 请复制等号右侧的实际值，不要写成 ${SUPERADMIN} 或 ${SUPERADMINPASSWORD}；
# notes_api.mjs 读取 .env 时不会展开变量引用。
NOTES_API_USERNAME=
NOTES_API_PASSWORD=
