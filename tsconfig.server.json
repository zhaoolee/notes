{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "verbatimModuleSyntax": true
  },
  "include": [
    "server/**/*.ts",
    "src/components/MarkdownText.tsx",
    "src/components/NoteSheet.tsx",
    "src/components/WechatArticle.tsx",
    "src/lib/markdown.ts",
    "src/types/app.ts"
  ]
}
