# Copy this file to .env and fill in the server-side Qiniu configuration.
# Never prefix these variables with VITE_, or they may be exposed to the browser.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com
QINIU_PREFIX=notes
# QINIU_UPLOAD_URL=https://upload.qiniup.com

# Server-only account configuration. Never prefix these with VITE_.
SUPERADMIN=
SUPERADMINPASSWORD=
# Use a long random value in production. If omitted, sessions are derived from
# the superadmin credentials and will be invalidated when that password changes.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Anonymous users share this many temporary Qiniu image uploads per Shanghai day.
ANONYMOUS_DAILY_UPLOAD_LIMIT=500

# Server-only OpenAI-compatible AI review service. Never prefix with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
# DeepSeek currently defaults to deepseek-v4-flash when this is omitted.
OPENAI_MODEL=deepseek-v4-flash
