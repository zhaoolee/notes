# Copy this file to .env and fill in the server-side Qiniu configuration.
# Never prefix these variables with VITE_, or they may be exposed to the browser.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com
QINIU_PREFIX=notes
# Usually leave this unset: the official Qiniu SDK discovers the bucket region
# and fails over across its upload endpoints automatically. A legacy single URL
# remains supported as a preferred endpoint, not the only endpoint.
# QINIU_UPLOAD_URL=https://upload-z2.qiniup.com
# Multiple custom endpoints are intended for diagnostics/private gateways only.
# QINIU_UPLOAD_URLS=http://upload-a.internal,http://upload-b.internal
# Total timeout for one upload attempt. Valid range: 10000-300000 milliseconds.
QINIU_UPLOAD_TIMEOUT_MS=30000

# Server-only account configuration. Never prefix these with VITE_.
SUPERADMIN=
SUPERADMINPASSWORD=
# Use a long random value in production. If omitted, sessions are derived from
# the superadmin credentials and will be invalidated when that password changes.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Optional private-deployment mode. When true, the home page requires a login
# and anonymous API access to editing, uploads, exports, and related services is denied.
REQUIRE_LOGIN=false
# Optional kill switch for importing a public WeChat article into a new note.
# Imports always require authentication and are limited to 30/hour per account.
# Set this to false on a public server if you also want to block the feature entirely.
# A reverse proxy should still rate-limit POST /api/import/wechat/preview.
WECHAT_IMPORT_ENABLED=true
# Optional canonical public origin written into downloaded Hermes Skill packages.
# Set this when a reverse proxy cannot provide correct forwarded host/protocol headers.
# NOTES_PUBLIC_BASE_URL=https://notes.example.com

# Anonymous users share this many temporary Qiniu image uploads per Shanghai day.
ANONYMOUS_DAILY_UPLOAD_LIMIT=500

# Server-only OpenAI-compatible AI review service. Never prefix with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
# DeepSeek currently defaults to deepseek-v4-flash when this is omitted.
OPENAI_MODEL=deepseek-v4-flash

# 可选：Hugo 网站一键发布 GitHub App（不配置时仍可导出 ZIP）
# Callback URL 和 Setup URL 均为 https://你的notes域名/api/site-publishing/github/callback
# App repository permissions: Contents、Pages、Administration 均 read/write；Metadata 默认只读。
# 不勾选安装时自动 OAuth，启用安装更新后返回 Setup URL；详见 DOCS/github-site-publishing.md。
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 二选一：容器内的 PEM 文件路径（推荐挂载只读文件），或带实际换行/\\n 的 PEM 字符串。
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=
# 独立、持久的 32 字节 Base64 密钥，可用 openssl rand -base64 32 生成；更换会使旧授权/发布清单失效。
GITHUB_PUBLISH_TOKEN_KEY=

# 可选：GitHub Pages 发布成功后，为该账号额外维护本站固定 /notes/ 镜像。
# 默认关闭；只有 SITE_PUBLISH_LOCAL_OWNER_ID 指定的 Notes 账号会看到本站状态。
# 静态文件写入 DATA_STORAGE_DIR/published-site，沿用现有 storage/data 数据目录。
SITE_PUBLISH_LOCAL_ENABLED=false
SITE_PUBLISH_LOCAL_OWNER_ID=superadmin
