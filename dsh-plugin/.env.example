# 便签服务基础地址（写入模式必填），例如 http://127.0.0.1:18080 或 https://notes.example.com
# 未配置时，工具回退到默认演示服务器匿名导出图片（不能写入便签列表）。
NOTES_API_BASE_URL=http://127.0.0.1:18080

# 优先使用稳定 Token（Bearer）。Token 缺失时，下面两个账号字段会用于一次性申请 Token。
NOTES_API_TOKEN=notes_sk_v1.xxx
NOTES_API_USERNAME=
NOTES_API_PASSWORD=

# 可选：未配置 NOTES_API_BASE_URL 时回退的演示服务器，默认 https://notes.fangyuanxiaozhan.com
NOTES_DEMO_SERVER=https://notes.fangyuanxiaozhan.com
